APP_ADDR=:8080
APP_BASE_URL=http://YOUR-HOST-IP:8080
APP_ALLOWED_ORIGINS=http://YOUR-HOST-IP:8080
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=changeme-now
APP_MASTER_KEY=replace-with-32-byte-base64-or-plain-secret
APP_SESSION_TTL_HOURS=24
CONTROL_DB_PATH=/data/10db-launch.sqlite
PG_ADMIN_HOST=your-postgres-host
